# =============================================================================
# Amplify — Azure China Dockerfile
# =============================================================================
# Every upstream image is pulled from the Microsoft Container Registry China
# endpoint (mcr.azure.cn), so this build does not require access to docker.io.
#
# The MCR Node image supplies a current Node.js release required by Prisma.
# Its Debian Bookworm runtime is paired with MCR's matching base image.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build Web (Vite frontend)
# ---------------------------------------------------------------------------
FROM mcr.azure.cn/devcontainers/javascript-node:20-bookworm AS web-builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages/ ./packages/
COPY apps/web/package.json ./apps/web/package.json

RUN corepack pnpm install --frozen-lockfile

COPY apps/web/ ./apps/web/

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN cd apps/web && corepack pnpm run build

# ---------------------------------------------------------------------------
# Stage 2: Build API (NestJS backend)
# ---------------------------------------------------------------------------
FROM mcr.azure.cn/devcontainers/javascript-node:20-bookworm AS api-builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/package.json

RUN corepack pnpm install --frozen-lockfile

COPY apps/api/ ./apps/api/

RUN cd apps/api && corepack pnpm exec prisma generate
RUN cd apps/api && corepack pnpm exec tsc -p tsconfig.json

# ---------------------------------------------------------------------------
# Stage 3: Production runtime
# ---------------------------------------------------------------------------
FROM mcr.azure.cn/devcontainers/base:bookworm AS runtime
USER root

RUN apt-get update \
    && apt-get install --no-install-recommends --yes nginx supervisor \
    && rm -rf /var/lib/apt/lists/*

# The Node.js distribution is self-contained under /usr/local and is copied
# from the MCR Node image so the runtime remains compatible with the builders.
COPY --from=api-builder /usr/local /usr/local

# --- API artifacts ---
WORKDIR /app

COPY --from=api-builder /app/node_modules ./node_modules
COPY --from=api-builder /app/apps/api/node_modules ./apps/api/node_modules
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY --from=api-builder /app/apps/api/dist ./apps/api/dist
COPY --from=api-builder /app/apps/api/generated ./apps/api/generated
COPY --from=api-builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=api-builder /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=api-builder /app/apps/api/src/config/database-url.ts ./apps/api/src/config/database-url.ts
COPY --from=api-builder /app/apps/api/tsconfig.json ./apps/api/tsconfig.json

# --- Web static files and Nginx configuration ---
COPY --from=web-builder /app/apps/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisord.conf /etc/supervisord.conf
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /run/nginx /var/log/nginx

# Azure App Service expects port 80.
EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
