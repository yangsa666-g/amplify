# =============================================================================
# Azure Deployment Environment Variables — Example
# =============================================================================
# Copy this file to .env.azure and fill in your actual values.
#   cp .env.azure.example .env.azure
#
# .env.azure is git-ignored and should NEVER be committed to source control.
# =============================================================================

# ─── Azure Resource Configuration ────────────────────────────────────────────
AZURE_SUBSCRIPTION=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group-name>
AZURE_LOCATION=<azure-region>                          # e.g. southeastasia, eastasia
AZURE_ACR_NAME=<your-acr-name>
AZURE_ACR_LOGIN_SERVER=<your-acr-name>.azurecr.io     # or custom login server URL
AZURE_ACR_USERNAME=<acr-admin-username>
AZURE_ACR_PASSWORD=<acr-admin-password>
AZURE_APP_NAME=<your-web-app-name>

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<your-postgres-password>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=<a-long-random-secret-string>
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_MODELS=gpt-4o,gpt-4o-mini
AZURE_OPENAI_TIMEOUT_MS=120000

# ─── Azure Document Intelligence ─────────────────────────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-document-intelligence-key>

# ─── Anthropic (optional) ────────────────────────────────────────────────────
ANTHROPIC_ENDPOINT=https://<your-foundry>.services.ai.azure.com/anthropic/
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7

# ─── Entra ID (optional, for SSO) ────────────────────────────────────────────
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=

# ─── Seed Admin ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<your-admin-password>
SEED_ADMIN_NAME=Admin

# ─── Upload ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
