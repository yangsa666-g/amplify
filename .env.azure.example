# =============================================================================
# Azure Deployment Environment Variables — Example
# =============================================================================
# Copy this file to .env.azure and fill in your actual values.
#   cp .env.azure.example .env.azure
#
# .env.azure is git-ignored and should NEVER be committed to source control.
# =============================================================================

# ─── Azure Resource Configuration ────────────────────────────────────────────
AZURE_SUBSCRIPTION=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group-name>
AZURE_LOCATION=<azure-region>                          # e.g. southeastasia, eastasia
AZURE_ACR_NAME=<your-acr-name>
AZURE_ACR_LOGIN_SERVER=<your-acr-name>.azurecr.io     # or custom login server URL
AZURE_ACR_USERNAME=<acr-admin-username>
AZURE_ACR_PASSWORD=<acr-admin-password>
AZURE_APP_NAME=<your-web-app-name>

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<your-postgres-password>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Required. Must be a strong random string of at least 16 chars; placeholder/
# default values are rejected at boot in production (see config/env.validation.ts).
JWT_SECRET=<a-long-random-secret-string>
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Audit Logs ──────────────────────────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=180

# ─── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-pro,gpt-5.4-mini
AZURE_OPENAI_TIMEOUT_MS=120000

# ─── Azure Document Intelligence ─────────────────────────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-document-intelligence-key>

# ─── Anthropic (optional) ────────────────────────────────────────────────────
ANTHROPIC_ENDPOINT=https://<your-foundry>.services.ai.azure.com/anthropic/
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7

# ─── Entra ID (optional, for SSO) ────────────────────────────────────────────
# Leave ENTRA_CLIENT_ID blank to disable SSO. Local password login is unaffected.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=https://<your-web-app-name>.azurewebsites.net/api/auth/entra/callback
ENTRA_POST_LOGIN_REDIRECT=https://<your-web-app-name>.azurewebsites.net/auth/callback

# ─── Seed Admin ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<your-admin-password>
SEED_ADMIN_NAME=Admin

# ─── Upload ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
AZURE_STORAGE_CONNECTION_STRING=<azure-storage-connection-string>   # Required for Azure deployments
AZURE_STORAGE_CONTAINER=uploads

# ─── Azure App Service ───────────────────────────────────────────────────────
WEBSITES_PORT=80                                       # tells Azure which container port to route traffic to
