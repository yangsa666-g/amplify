# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001                                   # API server port (default: 3001)
CORS_ORIGIN=http://localhost:3000           # Allowed CORS origin for the frontend

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Used by Docker Compose to initialize the local postgres container
POSTGRES_DB=contract_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Full connection URL used by Prisma. In Docker: host is the service name "postgres"
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/contract_ai

# ─── Authentication (JWT) ────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production         # Must be a strong random string in production
JWT_EXPIRES_IN=1h                          # Access token lifetime
REFRESH_TOKEN_EXPIRES_IN=7d               # Refresh token lifetime

# ─── Azure OpenAI ────────────────────────────────────────────────────────────
# Required: used for contract analysis and AI features
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
# Comma-separated list of deployed model names shown in the UI
AZURE_OPENAI_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-pro,gpt-5.4-mini
AZURE_OPENAI_TIMEOUT_MS=120000             # Request timeout in ms (default: 120000)
# AZURE_OPENAI_API_VERSION=2025-03-01-preview  # Optional: override API version

# ─── Azure Document Intelligence ─────────────────────────────────────────────
# Required: used for PDF/document parsing and OCR
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key

# ─── Anthropic Claude (optional) ─────────────────────────────────────────────
# Leave blank to disable. When set, Claude models appear alongside OpenAI models.
ANTHROPIC_ENDPOINT=https://api.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODELS=claude-opus-4-5,claude-sonnet-4-5

# ─── File Upload ─────────────────────────────────────────────────────────────
FILE_UPLOAD_DIR=/app/uploads               # Directory for uploaded files inside container
MAX_UPLOAD_SIZE_MB=20                      # Max file upload size in MB

# ─── Seed Admin ──────────────────────────────────────────────────────────────
# Required for `make seed` to create the initial admin account.
# If SEED_ADMIN_EMAIL is not set, the seed step is skipped.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_ADMIN_NAME=Admin
