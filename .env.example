APP_DOMAIN=localhost
NODE_ENV=development
PORT=3001

POSTGRES_DB=contract_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql://postgres:changeme@postgres:5432/contract_ai

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-pro,gpt-5.4-mini,
AZURE_OPENAI_TIMEOUT_MS=120000

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key

FILE_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=

CORS_ORIGIN=http://localhost:3000

# Initial admin user — required for `make seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_ADMIN_NAME=Admin
