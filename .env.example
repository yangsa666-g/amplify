APP_DOMAIN=localhost
NODE_ENV=development
PORT=3001

POSTGRES_DB=contract_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql://postgres:changeme@postgres:5432/contract_ai

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

AI_FOUNDRY_API_URL=https://your-foundry-endpoint
AI_FOUNDRY_API_KEY=your-api-key
AI_FOUNDRY_MODELS=gpt-5.4,gpt-5.4-mini
AI_FOUNDRY_TIMEOUT_MS=120000

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key

FILE_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=

CORS_ORIGIN=http://localhost:3000

# Initial admin user — required for `make seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_ADMIN_NAME=Admin
