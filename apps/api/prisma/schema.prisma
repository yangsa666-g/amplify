generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

enum AuthProvider {
  local
  entra
}

enum UserStatus {
  active
  disabled
}

enum TextExtractionStatus {
  pending
  success
  failed
}

enum JobStatus {
  pending
  running
  success
  failed
}

enum DiffMode {
  unified
  side_by_side
}

enum TemplateType {
  risk_analysis
}

enum TemplateKind {
  field
  prompt
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  template_request_submitted
  template_request_approved
  template_request_rejected
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?    @map("password_hash")
  authProvider AuthProvider @default(local) @map("auth_provider")
  entraOid     String?    @unique @map("entra_oid")
  role         Role       @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  documents       Document[]
  analysisJobs    AnalysisJob[]
  compareJobs     CompareJob[]
  fieldTemplates  FieldTemplate[]
  promptTemplates PromptTemplate[]
  feedbacks       AnalysisJobFeedback[]
  templateRequests TemplateRequest[]
  notifications   Notification[]
  reviewedRequests TemplateRequest[] @relation("ReviewedBy")

  @@map("users")
}

model FieldTemplate {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        FieldTemplateItem[]
  analysisJobs AnalysisJob[]
  templateRequests TemplateRequest[]

  @@map("field_templates")
}

model FieldTemplateItem {
  id               String   @id @default(cuid())
  templateId       String   @map("template_id")
  fieldName        String   @map("field_name")
  fieldDescription String   @map("field_description")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  template FieldTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("field_template_items")
}

model PromptTemplate {
  id           String       @id @default(cuid())
  userId       String?      @map("user_id")
  name         String
  templateType TemplateType @map("template_type")
  content      String
  isDefault    Boolean      @default(false) @map("is_default")
  isSystem     Boolean      @default(false) @map("is_system")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJobs AnalysisJob[]
  templateRequests TemplateRequest[]

  @@map("prompt_templates")
}

model Document {
  id                    String               @id @default(cuid())
  userId                String               @map("user_id")
  fileName              String               @map("file_name")
  fileType              String               @map("file_type")
  fileSize              Int                  @map("file_size")
  storagePath           String               @map("storage_path")
  extractedText         String?              @map("extracted_text")
  textExtractionStatus  TextExtractionStatus @default(pending) @map("text_extraction_status")
  extractionError       String?              @map("extraction_error")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJobs    AnalysisJob[]
  oldCompareJobs  CompareJob[]  @relation("OldDocument")
  newCompareJobs  CompareJob[]  @relation("NewDocument")

  @@map("documents")
}

model AnalysisJob {
  id                        String     @id @default(cuid())
  userId                    String     @map("user_id")
  documentId                String     @map("document_id")
  modelName                 String     @map("model_name")
  fieldTemplateId           String?    @map("field_template_id")
  promptTemplateId          String?    @map("prompt_template_id")
  fieldTemplateSnapshotJson Json?      @map("field_template_snapshot_json")
  promptSnapshotText        String?    @map("prompt_snapshot_text")
  status                    JobStatus  @default(pending)
  errorMessage              String?    @map("error_message")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  document              Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldTemplate         FieldTemplate?         @relation(fields: [fieldTemplateId], references: [id], onDelete: SetNull)
  promptTemplate        PromptTemplate?        @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  fieldExtractionResult FieldExtractionResult?
  riskAnalysisResult    RiskAnalysisResult?
  feedbacks             AnalysisJobFeedback[]

  @@map("analysis_jobs")
}

model FieldExtractionResult {
  id            String   @id @default(cuid())
  analysisJobId String   @unique @map("analysis_job_id")
  resultJson    Json     @map("result_json")
  createdAt     DateTime @default(now()) @map("created_at")

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@map("field_extraction_results")
}

model RiskAnalysisResult {
  id            String   @id @default(cuid())
  analysisJobId String   @unique @map("analysis_job_id")
  resultText    String   @map("result_text")
  createdAt     DateTime @default(now()) @map("created_at")

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@map("risk_analysis_results")
}

model CompareJob {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  oldDocumentId  String    @map("old_document_id")
  newDocumentId  String    @map("new_document_id")
  diffMode       DiffMode  @default(side_by_side) @map("diff_mode")
  status         JobStatus @default(pending)
  diffResultJson Json?     @map("diff_result_json")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldDocument Document @relation("OldDocument", fields: [oldDocumentId], references: [id], onDelete: Cascade)
  newDocument Document @relation("NewDocument", fields: [newDocumentId], references: [id], onDelete: Cascade)

  @@map("compare_jobs")
}

model AnalysisJobFeedback {
  id            String   @id @default(cuid())
  analysisJobId String   @map("analysis_job_id")
  userId        String   @map("user_id")
  rating        Int      // 1 = thumbs up, -1 = thumbs down
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([analysisJobId, userId])
  @@map("analysis_job_feedbacks")
}

model TemplateRequest {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  templateKind      TemplateKind  @map("template_kind")
  fieldTemplateId   String?       @map("field_template_id")
  promptTemplateId  String?       @map("prompt_template_id")
  status            RequestStatus @default(pending)
  adminNote         String?       @map("admin_note")
  reviewedById      String?       @map("reviewed_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?           @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  fieldTemplate   FieldTemplate?  @relation(fields: [fieldTemplateId], references: [id], onDelete: SetNull)
  promptTemplate  PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  notifications   Notification[]

  @@map("template_requests")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false) @map("is_read")
  requestId   String?          @map("request_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request TemplateRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@map("notifications")
}
