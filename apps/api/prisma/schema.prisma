generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

enum AuthProvider {
  local
  entra
}

enum UserStatus {
  active
  disabled
}

enum TextExtractionStatus {
  pending
  success
  failed
}

enum JobStatus {
  pending
  running
  success
  failed
}

enum TemplateType {
  risk_analysis
  contract_comparison
}

enum TemplateKind {
  field
  prompt
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  template_request_submitted
  template_request_approved
  template_request_rejected
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?      @map("password_hash")
  authProvider AuthProvider @default(local) @map("auth_provider")
  entraOid     String?      @unique @map("entra_oid")
  role         Role         @default(user)
  status       UserStatus   @default(active)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  documents        Document[]
  analysisJobs     AnalysisJob[]
  compareJobs      CompareJob[]
  fieldTemplates   FieldTemplate[]
  promptTemplates  PromptTemplate[]
  feedbacks        AnalysisJobFeedback[]
  compareFeedbacks CompareJobFeedback[]
  templateRequests TemplateRequest[]
  notifications    Notification[]
  reviewedRequests TemplateRequest[]     @relation("ReviewedBy")
  refreshTokens    RefreshToken[]
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]

  @@map("users")
}

model FieldTemplate {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            FieldTemplateItem[]
  analysisJobs     AnalysisJob[]
  templateRequests TemplateRequest[]

  @@map("field_templates")
}

model FieldTemplateItem {
  id               String   @id @default(cuid())
  templateId       String   @map("template_id")
  fieldName        String   @map("field_name")
  fieldDescription String   @map("field_description")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  template FieldTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("field_template_items")
}

model PromptTemplate {
  id           String       @id @default(cuid())
  userId       String?      @map("user_id")
  name         String
  templateType TemplateType @map("template_type")
  content      String
  isDefault    Boolean      @default(false) @map("is_default")
  isSystem     Boolean      @default(false) @map("is_system")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJobs     AnalysisJob[]
  compareJobs      CompareJob[]
  templateRequests TemplateRequest[]

  @@map("prompt_templates")
}

model Document {
  id                   String               @id @default(cuid())
  userId               String               @map("user_id")
  fileName             String               @map("file_name")
  fileType             String               @map("file_type")
  fileSize             Int                  @map("file_size")
  storagePath          String               @map("storage_path")
  extractedText        String?              @map("extracted_text")
  textExtractionStatus TextExtractionStatus @default(pending) @map("text_extraction_status")
  extractionError      String?              @map("extraction_error")
  extractionMs         Int?                 @map("extraction_ms")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJobs AnalysisJob[]
  compareJobs  CompareJobDocument[]

  @@map("documents")
}

model AnalysisJob {
  id                        String    @id @default(cuid())
  userId                    String    @map("user_id")
  documentId                String    @map("document_id")
  modelName                 String    @map("model_name")
  reasoningEffort           String    @default("medium") @map("reasoning_effort")
  fieldTemplateId           String?   @map("field_template_id")
  promptTemplateId          String?   @map("prompt_template_id")
  fieldTemplateSnapshotJson Json?     @map("field_template_snapshot_json")
  promptSnapshotText        String?   @map("prompt_snapshot_text")
  status                    JobStatus @default(pending)
  errorMessage              String?   @map("error_message")
  fieldExtractionMs         Int?      @map("field_extraction_ms")
  riskAnalysisMs            Int?      @map("risk_analysis_ms")
  fieldExtractionTokenUsage Json?     @map("field_extraction_token_usage")
  riskAnalysisTokenUsage    Json?     @map("risk_analysis_token_usage")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  document              Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldTemplate         FieldTemplate?         @relation(fields: [fieldTemplateId], references: [id], onDelete: SetNull)
  promptTemplate        PromptTemplate?        @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  fieldExtractionResult FieldExtractionResult?
  riskAnalysisResult    RiskAnalysisResult?
  feedbacks             AnalysisJobFeedback[]

  @@map("analysis_jobs")
}

model FieldExtractionResult {
  id            String   @id @default(cuid())
  analysisJobId String   @unique @map("analysis_job_id")
  resultJson    Json     @map("result_json")
  createdAt     DateTime @default(now()) @map("created_at")

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@map("field_extraction_results")
}

model RiskAnalysisResult {
  id            String   @id @default(cuid())
  analysisJobId String   @unique @map("analysis_job_id")
  resultText    String   @map("result_text")
  createdAt     DateTime @default(now()) @map("created_at")

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@map("risk_analysis_results")
}

model CompareJob {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  modelName          String    @map("model_name")
  reasoningEffort    String    @default("medium") @map("reasoning_effort")
  promptTemplateId   String?   @map("prompt_template_id")
  promptSnapshotText String    @map("prompt_snapshot_text")
  status             JobStatus @default(pending)
  resultText         String?   @map("result_text")
  analysisMs         Int?      @map("analysis_ms")
  tokenUsageJson     Json?     @map("token_usage_json")
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptTemplate PromptTemplate?      @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  documents      CompareJobDocument[]
  feedbacks      CompareJobFeedback[]

  @@map("compare_jobs")
}

model CompareJobDocument {
  compareJobId String @map("compare_job_id")
  documentId   String @map("document_id")
  sortOrder    Int    @map("sort_order")

  compareJob CompareJob @relation(fields: [compareJobId], references: [id], onDelete: Cascade)
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([compareJobId, documentId])
  @@unique([compareJobId, sortOrder])
  @@map("compare_job_documents")
}

model CompareJobFeedback {
  id           String   @id @default(cuid())
  compareJobId String   @map("compare_job_id")
  userId       String   @map("user_id")
  rating       Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  compareJob CompareJob @relation(fields: [compareJobId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([compareJobId, userId])
  @@map("compare_job_feedbacks")
}

model AnalysisJobFeedback {
  id            String   @id @default(cuid())
  analysisJobId String   @map("analysis_job_id")
  userId        String   @map("user_id")
  rating        Int // 1 = thumbs up, -1 = thumbs down
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([analysisJobId, userId])
  @@map("analysis_job_feedbacks")
}

model TemplateRequest {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  templateKind     TemplateKind  @map("template_kind")
  fieldTemplateId  String?       @map("field_template_id")
  promptTemplateId String?       @map("prompt_template_id")
  status           RequestStatus @default(pending)
  adminNote        String?       @map("admin_note")
  reviewedById     String?       @map("reviewed_by_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?           @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  fieldTemplate  FieldTemplate?  @relation(fields: [fieldTemplateId], references: [id], onDelete: SetNull)
  promptTemplate PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@map("template_requests")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  requestId String?          @map("request_id")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request TemplateRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique @map("key_hash")
  keyPrefix String    @map("key_prefix")
  expiresAt DateTime? @map("expires_at")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model ModelCatalogSetting {
  id                     String   @id @default(cuid())
  modelName              String   @unique @map("model_name")
  label                  String?
  enabled                Boolean  @default(true)
  defaultReasoningEffort String?  @map("default_reasoning_effort")
  sortOrder              Int?     @map("sort_order")
  isDefault              Boolean  @default(false) @map("is_default")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([enabled, sortOrder])
  @@index([isDefault])
  @@map("model_catalog_settings")
}

model OpenAICompatibleModel {
  id                String   @id @default(cuid())
  name              String   @unique
  endpoint          String
  upstreamModelName String   @map("upstream_model_name")
  apiProtocol       String   @default("chat_completions") @map("api_protocol")
  encryptedApiKey   String   @map("encrypted_api_key")
  supportsReasoning Boolean  @default(false) @map("supports_reasoning")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("openai_compatible_models")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  method     String
  path       String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  statusCode Int      @map("status_code")
  durationMs Int?     @map("duration_ms")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([method, createdAt])
  @@index([statusCode, createdAt])
  @@map("audit_logs")
}
